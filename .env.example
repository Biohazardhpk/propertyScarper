APIFY_TOKEN='apify_api_YOUR_API_KEY_HERE'

PROPERTY_SEARCH_REA_WORKER_URL=https://your-service.up.railway.app
PROPERTY_SEARCH_REA_WORKER_TOKEN=your_shared_worker_token

PROPERTY_SEARCH_DB=/data/property-search.sqlite
PROPERTY_SEARCH_PROFILE=/data/browser-profile
PROPERTY_SEARCH_DEFINITIONS=/data/definitions
PROPERTY_SEARCH_BROWSER_CHANNEL=chrome

# Local worker override (do not use the Railway /data path on your Mac)
PROPERTY_SEARCH_REA_WORKER_PROFILE=.property-search-profile
PROPERTY_SEARCH_REA_WORKER_TIMEOUT=0
# PROPERTY_SEARCH_REA_WORKER_HEADED=1
